# Archivo de referencia: no contiene credenciales reales.
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
TURSO_DATABASE_URL=file:./iphone-culture.db
# Solo para ejecutar migration:export contra la base anterior; no se usan al iniciar la aplicación.
SOURCE_DATABASE_URL=
SOURCE_AUTH_TOKEN=
# JWT_SECRET debe tener como mínimo 32 caracteres aleatorios.
JWT_SECRET=
# Creación segura de OpenAI pendiente de completar con el propietario.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Recuperado del sistema anterior. Mantener apagado hasta probar audios reales.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
AUTO_TRANSCRIBE_AUDIO=false
# Integración oficial Meta: confirmar versión y permisos en el panel de la aplicación.
META_GRAPH_VERSION=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
ALLOW_LIVE_MESSAGES=false
BACKUP_DIR=./backups
# Solo para instalar una base nueva; dejar vacíos al migrar la base existente.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Persistencia: en producción usar compose.yaml (volúmenes de datos separados).
PERSISTENT_STORAGE=false
MEDIA_DIR=./private-media
MEDIA_QUOTA_GB=20
ALLOW_MEDIA_DOWNLOADS=false
# Restic cifra antes de subir; usar un bucket privado de otra cuenta/servicio.
# Ejemplo de formato (sin credenciales): s3:https://endpoint/bucket/iphone-culture
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# Alternativa recomendada: montar un archivo secreto y definir RESTIC_PASSWORD_FILE.
RESTIC_PASSWORD_FILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# Objetivo de recuperación: hasta una hora entre copias completadas; vigilar fallos.
BACKUP_INTERVAL_MINUTES=60
